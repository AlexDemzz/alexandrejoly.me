{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "alexandrejoly",
  "homepage": "https://alexandrejoly.me",
  "items": [
    {
      "name": "notification-badge",
      "type": "registry:ui",
      "title": "Notification Badge",
      "description": "A counter or dot pinned to an icon or avatar, separated from it by a transparent gap punched with a clip-path.",
      "dependencies": ["class-variance-authority"],
      "registryDependencies": ["badge"],
      "files": [
        {
          "path": "registry/notification-badge.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "onboarding",
      "type": "registry:ui",
      "title": "Onboarding",
      "description": "A step-by-step onboarding flow with a segmented progress indicator, steps that cross as a View Transition and previous/next buttons.",
      "dependencies": [],
      "registryDependencies": ["button", "progress"],
      "files": [
        {
          "path": "registry/onboarding.tsx",
          "type": "registry:ui"
        }
      ],
      "css": {
        "[data-slot=\"onboarding-content\"]": {
          "view-transition-name": "match-element",
          "view-transition-class": "onboarding-step"
        },
        "::view-transition-old(*.onboarding-step)": {
          "animation": "200ms cubic-bezier(0.23, 1, 0.32, 1) both onboarding-step-out"
        },
        "::view-transition-new(*.onboarding-step)": {
          "animation": "250ms cubic-bezier(0.23, 1, 0.32, 1) both onboarding-step-in"
        },
        "@keyframes onboarding-step-out": {
          "to": { "opacity": "0", "filter": "blur(8px)" }
        },
        "@keyframes onboarding-step-in": {
          "from": { "opacity": "0", "filter": "blur(8px)" }
        },
        "@media (prefers-reduced-motion: reduce)": {
          "@keyframes onboarding-step-out": {
            "to": { "opacity": "0" }
          },
          "@keyframes onboarding-step-in": {
            "from": { "opacity": "0" }
          }
        }
      }
    },
    {
      "name": "hint",
      "type": "registry:ui",
      "title": "Hint",
      "description": "A contextual help bubble built on the Base UI Popover, opened from a trigger with an enlarged hit area.",
      "dependencies": [],
      "registryDependencies": ["popover"],
      "files": [
        {
          "path": "registry/hint.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "infinite-scroll",
      "type": "registry:ui",
      "title": "Infinite Scroll",
      "description": "Library-agnostic infinite pagination: a sentinel, polymorphic through Base UI useRender, fetches the next page when it scrolls into view.",
      "dependencies": ["@base-ui/react"],
      "registryDependencies": ["spinner"],
      "files": [
        {
          "path": "registry/infinite-scroll.tsx",
          "type": "registry:ui"
        }
      ]
    },
    {
      "name": "marquee",
      "type": "registry:ui",
      "title": "Marquee",
      "description": "A strip of items sliding in a seamless loop, in CSS alone, with edge fades, reverse and vertical tracks and pause on hover.",
      "dependencies": [],
      "registryDependencies": [],
      "files": [
        {
          "path": "registry/marquee.tsx",
          "type": "registry:ui"
        }
      ],
      "cssVars": {
        "theme": {
          "animate-marquee": "marquee var(--marquee-duration, 40s) linear infinite",
          "animate-marquee-reverse": "marquee var(--marquee-duration, 40s) linear infinite reverse",
          "animate-marquee-vertical": "marquee-vertical var(--marquee-duration, 40s) linear infinite"
        }
      },
      "css": {
        "@keyframes marquee": {
          "to": { "transform": "translateX(-50%)" }
        },
        "@keyframes marquee-vertical": {
          "to": { "transform": "translateY(-50%)" }
        }
      }
    }
  ]
}
