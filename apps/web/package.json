{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm registry:build && vite build",
    "registry:build": "shadcn build registry.json --output public/r && node scripts/sitemap.mjs",
    "registry:check": "shadcn registry validate registry.json",
    "serve": "vite preview",
    "deploy": "pnpm build && varlock-wrangler deploy",
    "dev": "pnpm registry:build && vite dev",
    "check-types": "pnpm registry:check && pnpm build && tsc --noEmit",
    "env:generate": "varlock codegen",
    "test": "vitest run"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@portfolio/ui": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "@tanstack/react-start": "^1.169.1",
    "class-variance-authority": "^0.7.1",
    "lucide-react": "^1.56.0",
    "next-themes": "catalog:",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "catalog:",
    "tailwindcss": "catalog:",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.64.0",
    "@portfolio/config": "workspace:*",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@varlock/cloudflare-integration": "1.6.2",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "shadcn": "^4.22.1",
    "shiki": "^4.5.0",
    "typescript": "catalog:",
    "vite": "^8.3.4",
    "vitest": "catalog:",
    "web-vitals": "^6.2.3"
  }
}
