{
  "name": "formula2030",
  "private": true,
  "type": "module",
  "scripts": {
    "registry:build": "pnpm --filter @portfolio/formula2030 registry:build",
    "build": "pnpm registry:build && node scripts/llms.mjs && vite build",
    "serve": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "dev": "pnpm registry:build && node scripts/llms.mjs && vite dev --port 3003",
    "check-types": "tsc --noEmit",
    "og": "node scripts/og.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@portfolio/formula2030": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "@ui-sdk/core": "0.1.0-beta.2",
    "@ui-sdk/react": "0.1.0-beta.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "catalog:"
  },
  "devDependencies": {
    "@babel/core": "catalog:",
    "@cloudflare/vite-plugin": "1.64.0",
    "@rolldown/plugin-babel": "catalog:",
    "@types/babel__core": "catalog:",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "babel-plugin-react-compiler": "catalog:",
    "playwright": "^1.64.1",
    "shiki": "^4.5.0",
    "typescript": "catalog:",
    "vite": "^8.3.5"
  }
}
