{
  "name": "responsivecn",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm og:images && vite build",
    "og:images": "node scripts/generate-images.ts",
    "serve": "vite preview",
    "deploy": "pnpm build && wrangler deploy",
    "dev": "pnpm og:images && vite dev --port 3000",
